<style>
@font-face{font-family:"Recoleta Custom";src:url("https://frutex-ks.com/wp-content/uploads/2026/04/RecoletaAlt-Thin.ttf") format("truetype");font-weight:100;font-style:normal;font-display:swap;}
@font-face{font-family:"Recoleta Custom";src:url("https://frutex-ks.com/wp-content/uploads/2026/04/Recoleta-Thin.ttf") format("truetype");font-weight:200;font-style:normal;font-display:swap;}
@font-face{font-family:"Recoleta Custom";src:url("https://frutex-ks.com/wp-content/uploads/2026/04/RecoletaAlt-Light.ttf") format("truetype");font-weight:300;font-style:normal;font-display:swap;}
@font-face{font-family:"Recoleta Custom";src:url("https://frutex-ks.com/wp-content/uploads/2026/04/RecoletaAlt-Regular.ttf") format("truetype");font-weight:400;font-style:normal;font-display:swap;}
@font-face{font-family:"Recoleta Custom";src:url("https://frutex-ks.com/wp-content/uploads/2026/04/RecoletaAlt-Medium.ttf") format("truetype");font-weight:500;font-style:normal;font-display:swap;}
@font-face{font-family:"Recoleta Custom";src:url("https://frutex-ks.com/wp-content/uploads/2026/04/RecoletaAlt-SemiBold.ttf") format("truetype");font-weight:600;font-style:normal;font-display:swap;}
@font-face{font-family:"Recoleta Custom";src:url("https://frutex-ks.com/wp-content/uploads/2026/04/RecoletaAlt-Bold.ttf") format("truetype");font-weight:700;font-style:normal;font-display:swap;}
@font-face{font-family:"Recoleta Custom";src:url("https://frutex-ks.com/wp-content/uploads/2026/04/RecoletaAlt-Black.ttf") format("truetype");font-weight:900;font-style:normal;font-display:swap;}

html,body{margin:0!important;padding:0!important;overflow-x:hidden!important;}

#nat100-embed{
  --bg:#f6f2e8;
  --surface:rgba(255,255,255,.62);
  --text:#17352c;
  --muted:#51645c;
  --line:rgba(23,53,44,.10);
  --shadow:0 18px 60px rgba(17,24,39,.10);
  --green:#275947;
  --fruit:#d94c3d;
  --gold:#d7a748;
  --max:1600px;
}

#nat100-embed,#nat100-embed *{margin:0;padding:0;box-sizing:border-box;}
#nat100-embed{
  font-family:"Recoleta Custom",serif;
  background:
    radial-gradient(circle at top left,rgba(215,167,72,.10),transparent 24%),
    radial-gradient(circle at bottom right,rgba(63,115,95,.10),transparent 28%),
    var(--bg);
  color:var(--text);
  overflow-x:hidden;
  width:100%!important;max-width:100%!important;margin:0!important;padding:0!important;
}

#nat100-embed img{display:block;max-width:100%;height:auto;}
#nat100-embed a{text-decoration:none;color:inherit;}
#nat100-embed .container{width:min(var(--max),calc(100% - 32px))!important;max-width:var(--max)!important;margin-left:auto!important;margin-right:auto!important;}
#nat100-embed .section{padding:96px 0;position:relative;}
#nat100-embed .section,#nat100-embed .hero,#nat100-embed .topbar{margin-top:0!important;}

#nat100-embed .glass{
  background:var(--surface);
  border:1px solid rgba(255,255,255,.60);
  box-shadow:var(--shadow);
  backdrop-filter:blur(18px);
  -webkit-backdrop-filter:blur(18px);
}

#nat100-embed .eyebrow{
  display:inline-flex;align-items:center;gap:10px;
  padding:8px 14px;border:1px solid var(--line);border-radius:999px;
  background:rgba(255,255,255,.55);color:var(--green);
  font-size:12px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;
  backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);
}
#nat100-embed .eyebrow::before{
  content:"";width:8px;height:8px;border-radius:50%;
  background:linear-gradient(135deg,var(--gold),var(--fruit));
  box-shadow:0 0 16px rgba(217,76,61,.30);
}

#nat100-embed h1,#nat100-embed h2,#nat100-embed h3,#nat100-embed h4,
#nat100-embed strong,#nat100-embed .btn,#nat100-embed .eyebrow,
#nat100-embed .brand-text strong,#nat100-embed .menu a,#nat100-embed .nav-cta,
#nat100-embed .nf-flavor-meta strong,#nat100-embed .nf-size-btn,#nat100-embed .nf-meta-chip{
  font-family:"Recoleta Custom",serif;letter-spacing:-.03em;line-height:1.02;font-weight:500;
}
#nat100-embed,#nat100-embed p,#nat100-embed span,#nat100-embed a,
#nat100-embed li,#nat100-embed button,#nat100-embed input,
#nat100-embed textarea,#nat100-embed select{font-family:"Recoleta Custom",serif;}
#nat100-embed p{color:var(--muted);line-height:1.75;}

/* ── NAV ── */
#nat100-embed .topbar{
  position:sticky;top:0;z-index:200;padding:16px 0;
  backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);
  background:rgba(246,242,232,.55);border-bottom:1px solid rgba(23,53,44,.06);
}
#nat100-embed .nav{
  display:flex;align-items:center;justify-content:space-between;
  gap:20px;min-height:68px;padding:0 16px;border-radius:999px;
}
#nat100-embed .brand{display:flex;align-items:center;gap:12px;min-width:0;}
#nat100-embed .brand-text strong{display:block;font-size:17px;font-weight:700;color:var(--green);}
#nat100-embed .brand-text span{display:block;font-size:13px;color:var(--muted);white-space:nowrap;}
#nat100-embed .menu{display:flex;align-items:center;gap:8px;flex-wrap:wrap;justify-content:center;}
#nat100-embed .menu a{padding:10px 14px;border-radius:999px;color:var(--green);font-size:14px;font-weight:600;transition:background .25s ease,color .25s ease,transform .25s ease;}
#nat100-embed .menu a:hover{background:rgba(39,89,71,.08);transform:translateY(-1px);}
#nat100-embed .nav-cta{display:inline-flex;align-items:center;justify-content:center;min-height:46px;padding:0 18px;border-radius:999px;background:var(--green);color:#fff;font-size:14px;font-weight:700;transition:transform .25s ease,box-shadow .25s ease;box-shadow:0 14px 28px rgba(39,89,71,.18);flex-shrink:0;}
#nat100-embed .nav-cta:hover{transform:translateY(-1px);box-shadow:0 18px 34px rgba(39,89,71,.24);}

/* ── HERO ── */
#nat100-embed .hero{padding:56px 0 44px;}
#nat100-embed .hero-grid{display:grid;grid-template-columns:1.02fr .98fr;gap:28px;align-items:center;}
#nat100-embed .hero-copy{padding:34px;border-radius:28px;position:relative;overflow:hidden;}
#nat100-embed .hero-copy::after{content:"";position:absolute;top:-80px;right:-60px;width:240px;height:240px;border-radius:50%;background:radial-gradient(circle,rgba(215,167,72,.20),transparent 70%);pointer-events:none;}
#nat100-embed .hero-copy h1{margin:18px 0 18px;font-size:clamp(42px,7vw,94px);color:var(--green);text-wrap:balance;}
#nat100-embed .hero-copy p{max-width:60ch;font-size:clamp(16px,1.5vw,20px);}
#nat100-embed .hero-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:28px;}
#nat100-embed .btn{display:inline-flex;align-items:center;justify-content:center;min-height:52px;padding:0 20px;border-radius:999px;font-size:15px;font-weight:700;transition:transform .25s ease,box-shadow .25s ease,background .25s ease;}
#nat100-embed .btn-primary{background:var(--green);color:#fff;box-shadow:0 16px 32px rgba(39,89,71,.20);}
#nat100-embed .btn-primary:hover{transform:translateY(-1px);}
#nat100-embed .btn-secondary{background:rgba(255,255,255,.55);color:var(--green);border:1px solid var(--line);}
#nat100-embed .hero-visual{position:relative;min-height:720px;border-radius:40px;overflow:hidden;background:radial-gradient(circle at 50% 28%,rgba(255,255,255,.75),transparent 34%),linear-gradient(180deg,#f5efe3 0%,#efe7d6 100%);border:1px solid rgba(255,255,255,.70);box-shadow:var(--shadow);}
#nat100-embed .hero-fruit-bg{position:absolute;inset:0;background-image:url("https://goldeneagle-ks.com/wp-content/uploads/2025/08/1920x765.3.png");background-size:cover;background-position:center;opacity:.42;transform:scale(1.04);}
#nat100-embed .hero-bottle{position:absolute;bottom:18px;left:50%;transform:translateX(-50%);width:min(420px,64%);z-index:2;filter:drop-shadow(0 30px 34px rgba(0,0,0,.14));animation:heroFloat 5s ease-in-out infinite;}
#nat100-embed .floating-card{position:absolute;z-index:3;border-radius:22px;padding:18px;min-width:180px;}
#nat100-embed .floating-card strong{display:block;color:var(--green);font-size:15px;margin-bottom:6px;font-weight:600;}
#nat100-embed .floating-card span{display:block;color:var(--muted);font-size:13px;line-height:1.5;}
#nat100-embed .floating-card.one{top:26px;left:26px;}
#nat100-embed .floating-card.two{top:110px;right:26px;}
#nat100-embed .floating-card.three{bottom:26px;right:26px;}

/* ── SECTION HEAD ── */
#nat100-embed .section-head{max-width:920px;margin:0 auto 38px;text-align:center;}
#nat100-embed .section-head h2{margin:18px 0 16px;font-size:clamp(34px,4.8vw,70px);color:var(--green);text-wrap:balance;}
#nat100-embed .section-head p{font-size:clamp(16px,1.3vw,19px);}

/* ── STORY ── */
#nat100-embed .story-grid{display:grid;grid-template-columns:.95fr 1.05fr;gap:28px;align-items:center;}
#nat100-embed .story-media{border-radius:34px;overflow:hidden;min-height:620px;position:relative;}
#nat100-embed .story-media img{width:100%;height:100%;object-fit:cover;}
#nat100-embed .story-copy{padding:34px;border-radius:34px;}
#nat100-embed .story-copy h2{margin:18px 0 18px;font-size:clamp(34px,4.6vw,64px);color:var(--green);text-wrap:balance;}
#nat100-embed .story-copy p+p{margin-top:16px;}

/* ── BENEFITS ── */
#nat100-embed .benefits-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;}
#nat100-embed .benefit-card{padding:26px 22px;border-radius:24px;text-align:left;}
#nat100-embed .benefit-icon{width:52px;height:52px;border-radius:16px;display:flex;align-items:center;justify-content:center;margin-bottom:18px;background:linear-gradient(135deg,rgba(215,167,72,.22),rgba(217,76,61,.16));color:var(--green);font-size:22px;font-weight:800;}
#nat100-embed .benefit-card h3{color:var(--green);font-size:22px;margin-bottom:8px;font-weight:500;}
#nat100-embed .benefit-card p{font-size:15px;}

/* ── SUGAR ── */
#nat100-embed .sugar-grid{display:grid;grid-template-columns:.98fr 1.02fr;gap:24px;align-items:center;}
#nat100-embed .sugar-copy{padding:34px;border-radius:32px;}
#nat100-embed .sugar-copy h2{margin:18px 0 16px;font-size:clamp(34px,4.8vw,70px);color:var(--green);text-wrap:balance;}
#nat100-embed .sugar-copy h3{font-size:clamp(22px,2vw,32px);color:var(--fruit);margin-bottom:14px;font-weight:400;}
#nat100-embed .sugar-copy p+p{margin-top:14px;}
#nat100-embed .sugar-media{border-radius:34px;overflow:hidden;min-height:340px;position:relative;}
#nat100-embed .sugar-media img{width:100%;height:100%;object-fit:cover;}

/* ── NUTRITION ── */
#nat100-embed .nutrition-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;}
#nat100-embed .nutrition-card{padding:28px;border-radius:24px;}
#nat100-embed .nutrition-card h3{color:var(--green);font-size:24px;margin:14px 0 8px;font-weight:500;}
#nat100-embed .nutrition-card p{font-size:15px;}

/* ── CTA ── */
#nat100-embed .cta-card{padding:40px;border-radius:36px;position:relative;overflow:hidden;text-align:center;background:radial-gradient(circle at top center,rgba(215,167,72,.16),transparent 40%),linear-gradient(180deg,rgba(255,255,255,.72),rgba(255,255,255,.58));}
#nat100-embed .cta-card h2{color:var(--green);font-size:clamp(34px,5vw,72px);margin:18px 0 16px;text-wrap:balance;}
#nat100-embed .cta-card p{max-width:740px;margin:0 auto;font-size:clamp(16px,1.35vw,19px);}
#nat100-embed .cta-card .btn{margin-top:24px;}

/* ── REVEAL ── */
#nat100-embed .reveal{opacity:0;transform:translateY(30px);transition:opacity .8s cubic-bezier(.22,.61,.36,1),transform .8s cubic-bezier(.22,.61,.36,1);}
#nat100-embed .reveal.is-visible{opacity:1;transform:translateY(0);}

/* ── TASTES SECTION ── */
#nat100-embed .nf-tastes .nf-flavor-showcase{position:relative;}
#nat100-embed .nf-tastes .nf-flavor-shell{display:grid;grid-template-columns:320px minmax(0,1fr);gap:24px;align-items:stretch;}
#nat100-embed .nf-tastes .nf-flavor-list{padding:16px;border-radius:30px;display:grid;gap:10px;max-height:760px;overflow:auto;}
#nat100-embed .nf-tastes .nf-flavor-list::-webkit-scrollbar{width:8px;}
#nat100-embed .nf-tastes .nf-flavor-list::-webkit-scrollbar-thumb{background:rgba(23,53,44,.18);border-radius:999px;}
#nat100-embed .nf-tastes .nf-flavor-item{width:100%;border:none;background:transparent;display:flex;align-items:center;gap:14px;text-align:left;padding:14px;border-radius:20px;cursor:pointer;transition:background .25s ease,transform .25s ease,box-shadow .25s ease;color:var(--green);}
#nat100-embed .nf-tastes .nf-flavor-item:hover{background:rgba(255,255,255,.5);transform:translateY(-1px);}
#nat100-embed .nf-tastes .nf-flavor-item.active{background:linear-gradient(135deg,var(--nf-flavor-soft,rgba(134,200,74,.16)),rgba(255,255,255,.62));box-shadow:inset 0 0 0 1px rgba(255,255,255,.5),0 12px 24px rgba(17,24,39,.06);}
#nat100-embed .nf-tastes .nf-flavor-swatch{width:18px;height:18px;border-radius:999px;flex-shrink:0;box-shadow:0 0 0 4px rgba(255,255,255,.4);background:var(--swatch,#86c84a);}
#nat100-embed .nf-tastes .nf-flavor-meta{min-width:0;}
#nat100-embed .nf-tastes .nf-flavor-meta strong{display:block;font-size:16px;font-weight:600;color:var(--green);margin-bottom:4px;}
#nat100-embed .nf-tastes .nf-flavor-meta span{display:block;font-size:13px;color:var(--muted);line-height:1.45;}
#nat100-embed .nf-tastes .nf-flavor-stage{position:relative;min-height:760px;border-radius:34px;overflow:hidden;isolation:isolate;background:linear-gradient(180deg,rgba(255,255,255,.48),rgba(255,255,255,.34));}
#nat100-embed .nf-tastes .nf-flavor-bg{position:absolute;inset:0;z-index:0;opacity:.98;background:radial-gradient(circle at 18% 22%,rgba(255,255,255,.70),transparent 18%),radial-gradient(circle at 84% 78%,rgba(255,255,255,.35),transparent 20%),linear-gradient(180deg,rgba(255,255,255,.24),rgba(255,255,255,.08));transition:background .5s ease;}
#nat100-embed .nf-tastes .nf-flavor-rings{position:absolute;inset:0;z-index:0;pointer-events:none;}
#nat100-embed .nf-tastes .nf-ring{position:absolute;border-radius:50%;filter:blur(38px);opacity:.85;transition:background .5s ease;}
#nat100-embed .nf-tastes .nf-r1{width:280px;height:280px;top:56px;left:56px;background:rgba(134,200,74,.16);}
#nat100-embed .nf-tastes .nf-r2{width:220px;height:220px;right:56px;bottom:72px;background:rgba(134,200,74,.26);}
#nat100-embed .nf-tastes .nf-flavor-fruits{position:absolute;inset:0;pointer-events:none;z-index:1;}
#nat100-embed .nf-tastes .nf-fruit{position:absolute;border-radius:50%;opacity:.82;animation:nfFloatPieces 7s ease-in-out infinite;box-shadow:inset 0 1px 10px rgba(255,255,255,.18);background:var(--fruit-fill,rgba(255,255,255,.22));}
#nat100-embed .nf-tastes .nf-f1{width:76px;height:76px;top:84px;left:82px;animation-delay:.2s;}
#nat100-embed .nf-tastes .nf-f2{width:50px;height:50px;top:188px;right:92px;animation-delay:1.1s;}
#nat100-embed .nf-tastes .nf-f3{width:92px;height:92px;bottom:122px;left:100px;animation-delay:2s;}
#nat100-embed .nf-tastes .nf-f4{width:58px;height:58px;bottom:90px;right:90px;animation-delay:2.8s;}
#nat100-embed .nf-tastes .nf-f5{width:34px;height:34px;top:50%;left:14%;animation-delay:3.4s;}

#nat100-embed .nf-tastes .nf-flavor-copy{position:absolute;top:28px;right:28px;width:min(360px,calc(100% - 56px));padding:22px;border-radius:24px;z-index:4;background:rgba(255,255,255,.58);border:1px solid rgba(255,255,255,.65);box-shadow:0 18px 60px rgba(17,24,39,.10);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);}
#nat100-embed .nf-tastes .nf-flavor-copy h3{font-size:clamp(30px,3vw,50px);color:var(--green);margin:14px 0 8px;}
#nat100-embed .nf-tastes .nf-flavor-copy h4{font-size:clamp(17px,1.4vw,22px);font-weight:400;color:var(--fruit);margin-bottom:12px;line-height:1.35;}
#nat100-embed .nf-tastes .nf-flavor-copy p{font-size:15px;line-height:1.75;color:var(--muted);}
#nat100-embed .nf-tastes .nf-meta-row{display:flex;flex-wrap:wrap;gap:10px;margin-top:18px;}
#nat100-embed .nf-tastes .nf-meta-chip{padding:10px 12px;border-radius:999px;background:rgba(255,255,255,.62);border:1px solid rgba(23,53,44,.08);color:var(--green);font-size:13px;font-weight:700;}

#nat100-embed .nf-tastes .nf-flavor-product-area{position:absolute;inset:0;z-index:3;display:grid;grid-template-columns:minmax(0,1fr) 380px;align-items:center;gap:24px;padding:42px 28px;}
#nat100-embed .nf-tastes .nf-flavor-product-wrap{position:relative;min-height:100%;display:flex;align-items:center;justify-content:center;padding:32px 20px 128px;isolation:isolate;}
#nat100-embed .nf-tastes .nf-product-shadow{position:absolute;left:50%;bottom:88px;width:min(420px,52%);height:38px;transform:translateX(-50%);background:radial-gradient(circle,rgba(0,0,0,.18),transparent 72%);filter:blur(14px);transition:opacity .18s ease;will-change:opacity;}
#nat100-embed .nf-tastes .nf-bottle{position:relative;display:block;max-width:none;max-height:min(70vh,620px);object-fit:contain;filter:drop-shadow(0 26px 30px rgba(0,0,0,.14));opacity:1;transition:opacity .22s ease;will-change:opacity;backface-visibility:hidden;transform-origin:center center;}
#nat100-embed .nf-tastes .nf-single-bottle{animation:none;}
#nat100-embed .nf-tastes .nf-single-bottle.entering{opacity:0;}
#nat100-embed .nf-tastes .nf-single-bottle.visible{opacity:1;}
#nat100-embed .nf-tastes .nf-single-bottle.leaving{opacity:0;}

#nat100-embed .nf-tastes .nf-size-switcher{position:absolute;left:50%;bottom:24px;transform:translateX(-50%);z-index:5;display:flex;gap:10px;flex-wrap:wrap;justify-content:center;padding:12px;border-radius:999px;background:rgba(255,255,255,.58);border:1px solid rgba(255,255,255,.66);box-shadow:0 18px 60px rgba(17,24,39,.10);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);}
#nat100-embed .nf-tastes .nf-size-btn{min-width:72px;min-height:42px;padding:0 16px;border:none;border-radius:999px;background:rgba(255,255,255,.65);color:var(--green);font-size:14px;font-weight:700;cursor:pointer;transition:background .25s ease,color .25s ease,transform .25s ease,box-shadow .25s ease;box-shadow:inset 0 0 0 1px rgba(23,53,44,.08);}
#nat100-embed .nf-tastes .nf-size-btn:hover{transform:translateY(-1px);}
#nat100-embed .nf-tastes .nf-size-btn.active{background:var(--green);color:#fff;box-shadow:0 10px 20px rgba(39,89,71,.18);}

/* ── PROGRESS DOTS ── */
#nat100-embed .nf-progress{
  position:absolute;right:18px;top:50%;transform:translateY(-50%);
  z-index:10;display:flex;flex-direction:column;gap:8px;align-items:center;
}
#nat100-embed .nf-progress-dot{
  width:6px;height:6px;border-radius:50%;
  background:rgba(23,53,44,.18);
  transition:background .35s ease,transform .35s ease;
}
#nat100-embed .nf-progress-dot.active{
  background:var(--green);
  transform:scaleY(1.6);
  border-radius:3px;
}

/* ── SCROLL HINT ── */
#nat100-embed .nf-scroll-hint{
  position:absolute;bottom:90px;left:50%;transform:translateX(-50%);
  z-index:10;display:flex;flex-direction:column;align-items:center;gap:8px;
  opacity:0;transition:opacity .4s ease;pointer-events:none;
}
#nat100-embed .nf-scroll-hint.visible{opacity:1;}
#nat100-embed .nf-scroll-hint span{
  font-size:11px;font-weight:700;letter-spacing:.12em;
  text-transform:uppercase;color:var(--green);opacity:.7;white-space:nowrap;
  font-family:"Recoleta Custom",serif;
}
#nat100-embed .nf-scroll-arrow{
  width:24px;height:24px;display:flex;align-items:center;justify-content:center;
  color:var(--green);opacity:.6;animation:nfBounceDown 1.6s ease-in-out infinite;
}

/* ── KEYFRAMES ── */
@keyframes heroFloat{0%,100%{transform:translateX(-50%) translateY(0);}50%{transform:translateX(-50%) translateY(-10px);}}
@keyframes nfFloatPieces{0%,100%{transform:translateY(0) translateX(0) scale(1);}50%{transform:translateY(-10px) translateX(4px) scale(1.04);}}
@keyframes nfBounceDown{0%,100%{transform:translateY(0);}50%{transform:translateY(5px);}}

/* ── RESPONSIVE ── */
@media (max-width:1280px){
  #nat100-embed .nf-tastes .nf-flavor-shell{grid-template-columns:280px minmax(0,1fr);}
  #nat100-embed .nf-tastes .nf-flavor-product-area{grid-template-columns:minmax(0,1fr) 340px;}
  #nat100-embed .nf-tastes .nf-flavor-copy{width:min(320px,calc(100% - 56px));}
}
@media (max-width:1200px){
  #nat100-embed .hero-grid,#nat100-embed .story-grid,#nat100-embed .sugar-grid{grid-template-columns:1fr;}
  #nat100-embed .hero-visual,#nat100-embed .story-media{min-height:560px;}
  #nat100-embed .sugar-media{min-height:300px;}
  #nat100-embed .benefits-grid{grid-template-columns:repeat(2,1fr);}
  #nat100-embed .nutrition-grid{grid-template-columns:1fr;}
  #nat100-embed .menu{display:none;}
  #nat100-embed .nav{justify-content:space-between;}
  #nat100-embed .nf-tastes .nf-flavor-shell{grid-template-columns:1fr;}
  #nat100-embed .nf-tastes .nf-flavor-list{grid-template-columns:repeat(4,1fr);max-height:none;overflow:visible;}
  #nat100-embed .nf-tastes .nf-flavor-stage{min-height:760px;}
  #nat100-embed .nf-tastes .nf-flavor-product-area{grid-template-columns:minmax(0,1fr) 320px;}
}
@media (max-width:900px){
  #nat100-embed .nf-tastes .nf-flavor-list{grid-template-columns:repeat(3,1fr);padding:12px;gap:10px;}
  #nat100-embed .nf-tastes .nf-flavor-item{flex-direction:column;justify-content:center;align-items:center;text-align:center;min-height:86px;padding:12px 10px;gap:10px;}
  #nat100-embed .nf-tastes .nf-flavor-meta{width:100%;}
  #nat100-embed .nf-tastes .nf-flavor-meta strong{margin:0;font-size:14px;line-height:1.2;}
  #nat100-embed .nf-tastes .nf-flavor-meta span{display:none;}
  #nat100-embed .nf-tastes .nf-flavor-swatch{width:16px;height:16px;box-shadow:none;}
  #nat100-embed .nf-tastes .nf-flavor-stage{min-height:auto;}
  #nat100-embed .nf-tastes .nf-flavor-product-area{position:relative;display:flex;flex-direction:column;align-items:stretch;padding:18px 18px 22px;gap:14px;}
  #nat100-embed .nf-tastes .nf-flavor-copy{position:relative;top:auto;right:auto;width:100%;order:3;margin:0;}
  #nat100-embed .nf-tastes .nf-flavor-product-wrap{min-height:420px;order:1;padding:20px 10px 24px;}
  #nat100-embed .nf-tastes .nf-size-switcher{position:relative;left:auto;bottom:auto;transform:none;width:100%;max-width:none;order:2;margin:-6px 0 0;align-self:stretch;}
  #nat100-embed .nf-tastes .nf-r1{width:180px;height:180px;top:26px;left:24px;}
  #nat100-embed .nf-tastes .nf-r2{width:160px;height:160px;right:22px;bottom:82px;}
  #nat100-embed .nf-progress{right:10px;}
}
@media (max-width:768px){
  #nat100-embed .section{padding:72px 0;}
  #nat100-embed .container{width:min(var(--max),calc(100% - 20px));}
  #nat100-embed .topbar{padding:10px 0;}
  #nat100-embed .nav{min-height:60px;border-radius:22px;}
  #nat100-embed .brand-text span{display:none;}
  #nat100-embed .nav-cta{min-height:42px;padding:0 14px;font-size:13px;}
  #nat100-embed .hero{padding:26px 0 20px;}
  #nat100-embed .hero-copy,#nat100-embed .story-copy,#nat100-embed .sugar-copy,#nat100-embed .cta-card{padding:24px 20px;}
  #nat100-embed .hero-visual,#nat100-embed .story-media{min-height:420px;border-radius:26px;}
  #nat100-embed .sugar-media{min-height:220px;border-radius:26px;}
  #nat100-embed .floating-card{min-width:auto;padding:14px;}
  #nat100-embed .floating-card.one{top:14px;left:14px;}
  #nat100-embed .floating-card.two{top:14px;right:14px;}
  #nat100-embed .floating-card.three{bottom:14px;right:14px;}
  #nat100-embed .benefits-grid{grid-template-columns:1fr;}
  #nat100-embed .nf-tastes .nf-flavor-list{grid-template-columns:repeat(3,1fr);gap:8px;padding:10px;border-radius:24px;}
  #nat100-embed .nf-tastes .nf-flavor-item{min-height:74px;padding:10px 8px;border-radius:16px;}
  #nat100-embed .nf-tastes .nf-flavor-meta strong{font-size:13px;}
  #nat100-embed .nf-tastes .nf-flavor-product-wrap{min-height:360px;}
  #nat100-embed .nf-tastes .nf-size-btn{min-width:64px;min-height:40px;font-size:13px;}
  #nat100-embed .nf-tastes .nf-flavor-copy{padding:18px 16px;}
  #nat100-embed .nf-tastes .nf-flavor-copy h3{font-size:34px;}
  #nat100-embed .nf-tastes .nf-flavor-copy h4{font-size:16px;}
  #nat100-embed .nf-tastes .nf-flavor-copy p{font-size:14px;line-height:1.7;}
}
@media (max-width:560px){
  #nat100-embed .brand{min-width:0;}
  #nat100-embed .brand-text strong{font-size:15px;}
  #nat100-embed .floating-card{display:none;}
  #nat100-embed .nf-tastes .nf-flavor-list{grid-template-columns:repeat(3,1fr);}
  #nat100-embed .nf-tastes .nf-flavor-item{min-height:72px;}
  #nat100-embed .nf-tastes .nf-flavor-meta strong{font-size:12px;}
  #nat100-embed .nf-tastes .nf-flavor-product-wrap{min-height:320px;}
  #nat100-embed .nf-tastes .nf-size-switcher{width:calc(100% - 20px);gap:8px;padding:10px;}
}
@media (max-width:420px){
  #nat100-embed .nf-tastes .nf-flavor-list{grid-template-columns:repeat(3,1fr);}
  #nat100-embed .nf-tastes .nf-flavor-item{min-height:68px;padding:10px 6px;}
  #nat100-embed .nf-tastes .nf-flavor-meta strong{font-size:11.5px;}
  #nat100-embed .nf-tastes .nf-product-shadow{width:190px;}
}
@media (prefers-reduced-motion:reduce){
  #nat100-embed .reveal,#nat100-embed .btn,#nat100-embed .menu a,
  #nat100-embed .nav-cta,#nat100-embed .hero-bottle{transition:none!important;animation:none!important;}
}


/* === FIX: Equal 0% added sugar cards + full image inside card === */
#nat100-embed .sugar-grid{
  align-items:stretch !important;
}

#nat100-embed .sugar-copy,
#nat100-embed .sugar-media{
  height:100% !important;
  min-height:clamp(360px, 28vw, 455px) !important;
}

#nat100-embed .sugar-media{
  padding:0 !important;
  display:block !important;
}

#nat100-embed .sugar-media img{
  position:absolute !important;
  inset:0 !important;
  width:100% !important;
  height:100% !important;
  max-width:none !important;
  object-fit:cover !important;
  object-position:center center !important;
}

@media (max-width:1200px){
  #nat100-embed .sugar-copy{
    min-height:auto !important;
  }
  #nat100-embed .sugar-media{
    min-height:360px !important;
  }
}

@media (max-width:768px){
  #nat100-embed .sugar-media{
    min-height:260px !important;
  }
}

@media (max-width:520px){
  #nat100-embed .sugar-media{
    min-height:220px !important;
  }
}

</style>

<script>
/* ── REVEAL ── */
(function(){
  const root = document.getElementById('nat100-embed');
  if(!root) return;
  const obs = new IntersectionObserver(entries=>{
    entries.forEach(e=>{ if(e.isIntersecting) e.target.classList.add('is-visible'); });
  },{ threshold:0.14 });
  root.querySelectorAll('.reveal').forEach(el=>obs.observe(el));
})();
</script>

