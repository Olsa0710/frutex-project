path d='M282 76.5l-14.2-14.3a9 9 0 0 0-13.1 0L142.5 174.4 30.3 62.2a9 9 0 0 0-13.2 0L3 76.5a9 9 0 0 0 0 13.1l133 133a9 9 0 0 0 13.1 0l133-133a9 9 0 0 0 0-13z' style='fill:%23666'/></svg>");background-position:50%;background-size:11px;background-repeat:no-repeat;transition:all .3s;transform:rotate(-180deg)}.gt_float_switcher .gt-selected .gt-current-lang span.gt_float_switcher-arrow.gt_arrow_rotate{transform:rotate(0deg)}</style><script src="./apple_files/wp-emoji-release.min.js.download" defer=""></script></head><body class="wp-singular page-template page-template-elementor_header_footer page page-id-285 wp-custom-logo wp-embed-responsive wp-theme-hello-elementor hello-elementor-default elementor-default elementor-template-full-width elementor-kit-7 elementor-page elementor-page-285 e--ua-blink e--ua-chrome e--ua-webkit" style="margin:0;padding:0;" data-elementor-device-mode="desktop"><header class="frutex-v4" id="frutexV4">
  <div class="frutex-v4__bar">
    <!-- LOGO -->
    <div class="frutex-v4__logo-wrap">
      <a href="https://frutex-ks.com/" class="frutex-v4__logo" aria-label="Frutex Home">
        <img class="lazy entered loaded" src="./apple_files/frutex_logo.svg" data-src="https://frutex-ks.com/wp-content/uploads/2026/04/frutex_logo.svg" alt="Frutex logo" data-ll-status="loaded">
      </a>
    </div>

    <!-- MENU -->
    <div class="frutex-v4__nav-wrap">
      <nav class="frutex-v4__nav" aria-label="Primary navigation">
        <a href="https://frutex-ks.com/" class="frutex-v4__link">Home</a>

        <div class="frutex-v4__item frutex-v4__item--dropdown">
          <button class="frutex-v4__trigger" type="button" aria-expanded="false">
            Brands
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path d="M5 7.5L10 12.5L15 7.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </button>
          <div class="frutex-v4__menu">
            <a href="https://frutex-ks.com/golden-eagle"><span class="notranslate brand-protected" translate="no">Golden Eagle</span></a>
            <a href="https://frutex-ks.com/natural-100"><span class="notranslate brand-protected" translate="no">Natural 100%</span></a>
            <a href="https://frutex-ks.com/relaxdrink"><span class="notranslate brand-protected" translate="no">Relax</span></a>
            <a href="https://frutex-ks.com/art-food"><span class="notranslate brand-protected" translate="no">Art Food</span></a>
            <a href="https://frutex-ks.com/zeros"><span class="notranslate brand-protected" translate="no">ZEROS</span></a>
          </div>
        </div>

        <a href="https://frutex-ks.com/rrethnesh" class="frutex-v4__link">About Us</a>
        <a href="https://frutex-ks.com/lajmetfrutex" class="frutex-v4__link">News</a>
        <a href="https://frutex-ks.com/contact-us" class="frutex-v4__link">Contact</a>

        <div class="frutex-v4__item frutex-v4__item--dropdown">
          <button class="frutex-v4__trigger" type="button" aria-expanded="false">
            Foundation
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path d="M5 7.5L10 12.5L15 7.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </button>
          <div class="frutex-v4__menu">
            <a href="https://frutex-ks.com/foundation"><span class="notranslate brand-protected" translate="no">Golden Eagle Foundation</span></a>
            <a href="https://frutex-ks.com/freesia"><span class="notranslate brand-protected" translate="no">Freesia</span></a>
          </div>
        </div>

        <div class="frutex-v4__item frutex-v4__item--dropdown">
          <button class="frutex-v4__trigger" type="button" aria-expanded="false">
            Career
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path d="M5 7.5L10 12.5L15 7.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </button>
          <div class="frutex-v4__menu">
            <a href="https://frutex-ks.com/apliko-per-pune">Apply for job</a>
          </div>
        </div>
      </nav>
    </div>

    <!-- BUTTON -->
    <div class="frutex-v4__cta-wrap">
      <a href="mailto:info@goldeneagle-ks.com" class="frutex-v4__partner">
        Become our partner
      </a>

      <button class="frutex-v4__burger" id="frutexV4Burger" type="button" aria-label="Open menu" aria-expanded="false">
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  <!-- MOBILE -->
  <div class="frutex-v4__mobile" id="frutexV4Mobile">
    <div class="frutex-v4__mobile-inner">
      <a href="https://frutex-ks.com/" class="frutex-v4__mobile-link">Home</a>

      <details class="frutex-v4__mobile-group">
        <summary>Brands</summary>
        <div class="frutex-v4__mobile-submenu">
