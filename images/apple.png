          <a href="https://frutex-ks.com/relaxdrink"><span class="notranslate brand-protected" translate="no">Relax</span></a>
          <a href="https://frutex-ks.com/art-food"><span class="notranslate brand-protected" translate="no">Art Food</span></a>
          <a href="https://frutex-ks.com/zeros"><span class="notranslate brand-protected" translate="no">ZEROS</span></a>
        </div>
      </details>

      <a href="https://frutex-ks.com/rrethnesh" class="frutex-v4__mobile-link">About Us</a>
      <a href="https://frutex-ks.com/lajmetfrutex" class="frutex-v4__mobile-link">News</a>
      <a href="https://frutex-ks.com/contact-us" class="frutex-v4__mobile-link">Contact</a>

      <details class="frutex-v4__mobile-group">
        <summary>Foundation</summary>
        <div class="frutex-v4__mobile-submenu">
          <a href="https://frutex-ks.com/foundation"><span class="notranslate brand-protected" translate="no">Golden Eagle Foundation</span></a>
          <a href="https://frutex-ks.com/freesia"><span class="notranslate brand-protected" translate="no">Freesia</span></a>
        </div>
      </details>

      <details class="frutex-v4__mobile-group">
        <summary>Career</summary>
        <div class="frutex-v4__mobile-submenu">
          <a href="https://frutex-ks.com/apliko-per-pune">Apply for job</a>
        </div>
      </details>

      <a href="mailto:info@frutexgroup.com" class="frutex-v4__mobile-cta">Become our partner</a>
    </div>
  </div>
</header>

<style>
  .frutex-v4,
  .frutex-v4 * {
    box-sizing: border-box;
    font-family: "SF Pro Display","SF Pro Text",Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif !important;
  }

  .frutex-v4 {
    --frx-green-dark: #0f5d43;
    --frx-green: #167a59;
    --frx-green-light: #1b8b66;
    --frx-text: #1a3f31;
    --frx-border: rgba(22,122,89,0.14);
    --frx-bg-top: rgba(255,255,255,0.92);
    --frx-bg-bottom: rgba(255,255,255,0.68);
    --frx-shadow: 0 16px 40px rgba(15,93,67,0.10), 0 28px 70px rgba(15,93,67,0.10);

    position: relative !important;
    top: auto !important;
    z-index: 100 !important;
    width: min(1480px, calc(100% - 20px)) !important;
    margin: 22px auto 0 !important;
  }

  .frutex-v4__bar {
    display: grid !important;
    grid-template-columns: minmax(180px, 220px) minmax(0, 1fr) auto !important;
    align-items: center !important;
    column-gap: clamp(16px, 2vw, 32px) !important;
    min-height: 84px !important;
    padding: 12px 18px !important;
    border-radius: 999px !important;
    border: 1px solid var(--frx-border) !important;
    background: linear-gradient(180deg, var(--frx-bg-top), var(--frx-bg-bottom)) !important;
    backdrop-filter: blur(18px) saturate(160%) !important;
    -webkit-backdrop-filter: blur(18px) saturate(160%) !important;
    box-shadow: var(--frx-shadow) !important;
  }

  .frutex-v4__logo-wrap,
  .frutex-v4__nav-wrap,
  .frutex-v4__cta-wrap {
    min-width: 0 !important;
    display: flex !important;
    align-items: center !important;
  }

  .frutex-v4__logo-wrap {
    justify-content: flex-start !important;
  }

  .frutex-v4__nav-wrap {
    justify-content: center !important;
    width: 100% !important;
    min-width: 0 !important;
  }

  .frutex-v4__cta-wrap {
    justify-content: flex-end !important;
    gap: 12px !important;
    min-width: max-content !important;
  }

  .frutex-v4__logo {
    display: inline-flex !important;
    align-items: center !important;
    text-decoration: none !important;
    flex: 0 0 auto !important;
  }

  .frutex-v4__logo img {
    display: block !important;
    height: 38px !important;
    width: auto !important;
    max-width: 210px !important;
    object-fit: contain !important;
  }

  .frutex-v4__nav {
    display: flex !important;
    align-items: center !important;
    justify-content: space-evenly !important;
    width: 100% !important;
    max-width: 820px !important;
    gap: 12px !important;
    min-width: 0 !important;
    flex-wrap: nowrap !important;
    white-space: nowrap !important;
  }

  .frutex-v4__item {
    position: relative !important;
    flex: 0 0 auto !important;
    display: inline-flex !important;
    align-items: center !important;
  }

