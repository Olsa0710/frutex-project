    { key:"pear",name:"Pear",subtitle:"Subtle fruit softness with a calm natural profile.",desc:"A quieter and cleaner flavor direction that feels smooth, balanced, and rooted in natural simplicity.",color:"#b1bf4d",fruitFill:"radial-gradient(circle at 30% 30%, #fbfbe2, #b9c856 58%, #7f9230 100%)",bg:"radial-gradient(circle at 22% 78%, rgba(161,184,74,.22), transparent 18%), radial-gradient(circle at 76% 24%, rgba(208,206,123,.16), transparent 18%), linear-gradient(180deg,#f7faec 0%, #ecefd5 100%)",meta:["Gentle fruit","Balanced taste","Clean profile"],sizes:{"200ml":"https://frutex-ks.com/wp-content/uploads/2026/03/Pear-200ml-510x722-1.webp","750ml":"https://frutex-ks.com/wp-content/uploads/2026/03/Pear-750ml-510x722-1.webp"}},
    { key:"sourcherry",name:"Sourcherry",subtitle:"Sweet and sour intensity with a richer fruit mood.",desc:"A vivid sour cherry profile that feels expressive and memorable, balancing freshness with a more concentrated fruit identity.",color:"#cb4755",fruitFill:"radial-gradient(circle at 30% 30%, #fff2ef, #d94950 58%, #7f3153 100%)",bg:"radial-gradient(circle at 18% 26%, rgba(195,48,55,.20), transparent 18%), radial-gradient(circle at 78% 76%, rgba(128,42,54,.16), transparent 18%), linear-gradient(180deg,#fff0ee 0%, #f5e1dd 100%)",meta:["Sweet & sour","100% local mood","Bold berry tone"],sizes:{"200ml":"https://frutex-ks.com/wp-content/uploads/2026/03/Natural-Sourcherry-200ml.webp","250ml":"https://frutex-ks.com/wp-content/uploads/2026/03/Natural-Sourcherry-250ml.webp","750ml":"https://frutex-ks.com/wp-content/uploads/2026/03/Natural-Sourcherry-750ml.webp"}},
    { key:"grape",name:"Grape",subtitle:"Deep fruit character with a cooler visual tone.",desc:"A darker fruit identity that feels smooth, calm, and slightly more premium inside the lineup.",color:"#5d54b5",fruitFill:"radial-gradient(circle at 30% 30%, #f1efff, #6b61d3 58%, #403990 100%)",bg:"radial-gradient(circle at 18% 26%, rgba(82,71,180,.22), transparent 18%), radial-gradient(circle at 82% 76%, rgba(125,95,205,.16), transparent 18%), linear-gradient(180deg,#f1efff 0%, #e5e0f7 100%)",meta:["Dark fruit tone","Single format","Cool finish"],sizes:{"250ml":"https://frutex-ks.com/wp-content/uploads/2026/03/Natural-Grape-250ml.webp"}},
    { key:"blueberry",name:"Blueberry",subtitle:"Dark fruit notes with a calm premium feel.",desc:"A deeper visual and flavor direction that feels sophisticated, smooth, and naturally distinctive inside the collection.",color:"#5574cc",fruitFill:"radial-gradient(circle at 30% 30%, #eef4ff, #5574cc 58%, #2f4479 100%)",bg:"radial-gradient(circle at 18% 78%, rgba(50,75,140,.22), transparent 18%), radial-gradient(circle at 80% 20%, rgba(80,104,173,.18), transparent 18%), linear-gradient(180deg,#eef3fb 0%, #e2e9f6 100%)",meta:["Dark fruit tone","Smooth finish","Premium mood"],sizes:{"200ml":"https://frutex-ks.com/wp-content/uploads/2026/03/Natural-Blueberry-200ml.webp","750ml":"https://frutex-ks.com/wp-content/uploads/2026/03/Natural-Blueberry-750ml.webp"}},
    { key:"apple-clear",name:"Apple Clear",subtitle:"Cleaner visual style with a lighter apple feel.",desc:"A softer and more delicate apple expression built around freshness, simplicity, and an easy everyday impression.",color:"#d8d060",fruitFill:"radial-gradient(circle at 30% 30%, #fffbe1, #d8d060 58%, #9ba53f 100%)",bg:"radial-gradient(circle at 22% 78%, rgba(214,208,120,.20), transparent 18%), radial-gradient(circle at 82% 24%, rgba(170,191,76,.16), transparent 18%), linear-gradient(180deg,#fcfbf0 0%, #f0edd5 100%)",meta:["Light apple","Single format","Minimal look"],sizes:{"200ml":"https://frutex-ks.com/wp-content/uploads/2026/03/Natural-Apple-clear-200ml.webp"}},
    { key:"orange",name:"Orange",subtitle:"Bright citrus energy with a juicy vibrant feel.",desc:"A lively citrus profile designed to feel sunny, fresh, and immediately approachable across the Natural range.",color:"#ff9c3a",fruitFill:"radial-gradient(circle at 30% 30%, #fff5df, #ffab48 58%, #dd6e1d 100%)",bg:"radial-gradient(circle at 18% 30%, rgba(255,145,56,.22), transparent 18%), radial-gradient(circle at 82% 72%, rgba(255,195,95,.18), transparent 18%), linear-gradient(180deg,#fff3e7 0%, #f8e2c8 100%)",meta:["Citrus profile","Juicy mood","Bright refreshment"],sizes:{"200ml":"https://frutex-ks.com/wp-content/uploads/2026/03/Natural-Orange-200ml.webp","250ml":"https://frutex-ks.com/wp-content/uploads/2026/03/Natural-Orange-250ml.webp","750ml":"https://frutex-ks.com/wp-content/uploads/2026/03/Natural-Orange-750ml.webp"}},
    { key:"peach",name:"Peach",subtitle:"Soft stone-fruit sweetness with a warm gentle mood.",desc:"Designed to feel smooth, mellow, and approachable, with a warmer visual language than the sharper citrus and berry options.",color:"#f2a06b",fruitFill:"radial-gradient(circle at 30% 30%, #fff4eb, #f4a46c 58%, #d77845 100%)",bg:"radial-gradient(circle at 20% 76%, rgba(255,164,107,.20), transparent 18%), radial-gradient(circle at 78% 22%, rgba(255,212,159,.16), transparent 18%), linear-gradient(180deg,#fff4ec 0%, #f6e5d7 100%)",meta:["Soft sweetness","Warm mood","Stone fruit profile"],sizes:{"200ml":"https://frutex-ks.com/wp-content/uploads/2026/03/Natural-Peach-200ml.webp","250ml":"https://frutex-ks.com/wp-content/uploads/2026/03/Natural-Peach-250ml.webp","750ml":"https://frutex-ks.com/wp-content/uploads/2026/03/Natural-Peach-750ml.webp"}},
    { key:"multivitamin",name:"Multivitamin",subtitle:"A colorful fruit blend with a bright vitamin-led character.",desc:"Natural Multivitamin adds a vivid, feel-good fruit blend to the Natural 100% range, designed for everyday freshness with a colorful and energetic taste profile.",color:"#f29b3b",fruitFill:"radial-gradient(circle at 30% 30%, #fff4df, #f29b3b 58%, #d86f25 100%)",bg:"radial-gradient(circle at 18% 30%, rgba(242,155,59,.24), transparent 18%), radial-gradient(circle at 82% 72%, rgba(217,76,61,.16), transparent 18%), linear-gradient(180deg,#fff4e4 0%, #f8e4c8 100%)",meta:["Fruit blend","Vitamin mood","Fresh character"],sizes:{"200ml":"https://frutex-ks.com/wp-content/uploads/2026/04/Natural100_3_Multivitamin-200ml-scaled.png","750ml":"https://frutex-ks.com/wp-content/uploads/2026/04/Natural-100-Multivitamin-750ml-scaled.png"}}
  ];

  /* ─ DOM REFS ─ */
  const flavorList    = document.getElementById('nat100-nfFlavorList');
  const flavorBg      = document.getElementById('nat100-nfFlavorBg');
  const fruitsEl      = document.getElementById('nat100-nfFlavorFruits');
  const ring1         = document.getElementById('nat100-nfRing1');
  const ring2         = document.getElementById('nat100-nfRing2');
  const titleEl       = document.getElementById('nat100-nfFlavorTitle');
  const subtitleEl    = document.getElementById('nat100-nfFlavorSubtitle');
  const descEl        = document.getElementById('nat100-nfFlavorDesc');
  const eyebrowEl     = document.getElementById('nat100-nfFlavorEyebrow');
  const metaEl        = document.getElementById('nat100-nfFlavorMeta');
  const sizeSwitcher  = document.getElementById('nat100-nfSizeSwitcher');
  const bottle        = document.getElementById('nat100-nfActiveBottle');
  const shadow        = document.getElementById('nat100-nfProductShadow');
  const progressEl    = document.getElementById('nat100-nfProgress');
  const hintEl        = document.getElementById('nat100-nfScrollHint');
  const hintTextEl    = document.getElementById('nat100-nfScrollHintText');
  const tastesSection = document.getElementById('nat100-tastes');

  /* ─ STATE ─ */
  let activeFlavor   = 0;
  let activeSize     = null;
  let preferredSize  = null;
  let isAnimBottle   = false;
  const imageCache   = new Map();

  /* ─ HELPERS ─ */
  function rgba(hex, a){
    let c=hex.replace('#','');
    if(c.length===3) c=c.split('').map(x=>x+x).join('');
    const n=parseInt(c,16);
    return `rgba(${(n>>16)&255},${(n>>8)&255},${n&255},${a})`;
  }

  function preloadImage(src){
    if(imageCache.has(src)) return imageCache.get(src);
    const img=new Image();
    const p=new Promise(res=>{ img.onload=()=>res(img); img.onerror=()=>res(img); });
    img.src=src; imageCache.set(src,p); return p;
  }

  function preloadAll(){
    flavors.forEach(f=>Object.values(f.sizes).forEach(preloadImage));
  }

  function bottleWidthFor(flavor,size){
    const is200=size.includes('200');
    const is250=size.includes('250');
    const isMulti200 = flavor && flavor.key === 'multivitamin' && is200;
    const w=window.innerWidth;

    /* Keep every product exactly as before, but make ONLY Multivitamin 200ml
       larger through width (not transform) so it stays centered like the others. */
    if(w<=420){
      if(isMulti200) return 'clamp(202px,66vw,224px)';
      if(is200) return 'clamp(138px,48vw,150px)';
      if(is250) return 'clamp(144px,50vw,158px)';
      return 'clamp(176px,56vw,198px)';
    }
    if(w<=560){
      if(isMulti200) return 'clamp(218px,64vw,250px)';
      if(is200) return 'clamp(150px,46vw,166px)';
      if(is250) return 'clamp(156px,48vw,174px)';
      return 'clamp(188px,56vw,218px)';
    }
    if(w<=900){
      if(isMulti200) return 'clamp(258px,50vw,312px)';
      if(is200) return 'clamp(176px,34vw,205px)';
      if(is250) return 'clamp(186px,36vw,220px)';
      return 'clamp(220px,46vw,272px)';
    }
    if(w<=1280){
      if(isMulti200) return 'clamp(322px,28vw,382px)';
      if(is200) return 'clamp(210px,18vw,248px)';
      if(is250) return 'clamp(224px,20vw,266px)';
      return 'clamp(270px,25vw,332px)';
    }
    if(isMulti200) return 'clamp(352px,25vw,426px)';
    if(is200) return 'clamp(228px,16vw,270px)';
    if(is250) return 'clamp(242px,18vw,290px)';
    return 'clamp(300px,23vw,372px)';
  }

  function getPreferredSize(flavor){
    if(preferredSize && flavor.sizes[preferredSize]) return preferredSize;
    if(activeSize && flavor.sizes[activeSize]) return activeSize;
    return Object.keys(flavor.sizes)[0];
  }

  /* ─ RENDER ─ */
  function buildFruits(flavor){
    fruitsEl.innerHTML='';
    ['nf-f1','nf-f2','nf-f3','nf-f4','nf-f5'].forEach(cls=>{
      const el=document.createElement('div');
      el.className=`nf-fruit ${cls}`;
      el.style.background=flavor.fruitFill;
      fruitsEl.appendChild(el);
    });
  }

  function renderMeta(items){
    metaEl.innerHTML='';
    items.forEach(item=>{
      const chip=document.createElement('span');
      chip.className='nf-meta-chip';chip.textContent=item;
      metaEl.appendChild(chip);
    });
  }

  function renderSizes(flavor){
    sizeSwitcher.innerHTML='';
    Object.keys(flavor.sizes).forEach(size=>{
      const btn=document.createElement('button');
      btn.className='nf-size-btn'+(size===activeSize?' active':'');
      btn.textContent=size;
      btn.addEventListener('click',()=>{
        if(size===activeSize||isAnimBottle) return;
        activeSize=size; preferredSize=size;
        renderSizes(flavor);
        renderBottle(flavor,false);
      });
      sizeSwitcher.appendChild(btn);
    });
  }

  async function renderBottle(flavor, immediate){
    const src=flavor.sizes[activeSize];
    if(!src) return;
    const nextWidth=bottleWidthFor(flavor,activeSize);

    if(immediate){
      await preloadImage(src);
      bottle.src=src; bottle.alt=`${flavor.name} ${activeSize} bottle`;
      bottle.style.width=nextWidth;
      bottle.style.transform='none';
      bottle.classList.remove('entering','leaving'); bottle.classList.add('visible');
      if(shadow) shadow.style.opacity='1';
      isAnimBottle=false; return;
    }

    isAnimBottle=true;
    bottle.classList.remove('entering','visible'); bottle.classList.add('leaving');
    if(shadow) shadow.style.opacity='.72';

    await new Promise(r=>setTimeout(r,120));
    await preloadImage(src);

    bottle.src=src; bottle.alt=`${flavor.name} ${activeSize} bottle`;
    bottle.style.width=nextWidth;
    bottle.style.transform='none';
    bottle.classList.remove('leaving','visible'); bottle.classList.add('entering');

    requestAnimationFrame(()=>requestAnimationFrame(()=>{
      bottle.classList.remove('entering'); bottle.classList.add('visible');
      if(shadow) shadow.style.opacity='1';
    }));

    setTimeout(()=>{ isAnimBottle=false; }, 260);
  }

  function renderList(){
    flavorList.innerHTML='';
    flavors.forEach((flavor,index)=>{
      const btn=document.createElement('button');
      btn.className='nf-flavor-item'+(index===activeFlavor?' active':'');
      btn.style.setProperty('--swatch',flavor.color);
      btn.innerHTML=`<span class="nf-flavor-swatch"></span><span class="nf-flavor-meta"><strong>${flavor.name}</strong><span>${Object.keys(flavor.sizes).join(' • ')}</span></span>`;
      btn.addEventListener('click',()=>{
        if(index===activeFlavor||isAnimBottle) return;
        goToFlavor(index,true);
      });
      flavorList.appendChild(btn);
    });
  }

  function buildProgressDots(){
    progressEl.innerHTML=flavors.map((_,i)=>
      `<div class="nf-progress-dot${i===activeFlavor?' active':''}" data-i="${i}"></div>`
    ).join('');
  }

  function updateProgressDots(){
    progressEl.querySelectorAll('.nf-progress-dot').forEach((dot,i)=>{
      dot.classList.toggle('active',i===activeFlavor);
    });
  }

  async function renderFlavor(index, animateBottle){
    const flavor=flavors[index];
    activeFlavor=index;
    activeSize=getPreferredSize(flavor);

    renderList();
    flavorBg.style.background=flavor.bg;
    ring1.style.background=rgba(flavor.color,.18);
    ring2.style.background=rgba(flavor.color,.28);
    buildFruits(flavor);
    eyebrowEl.textContent=`Natural Flavor • ${Object.keys(flavor.sizes).length} format${Object.keys(flavor.sizes).length>1?'s':''}`;
    titleEl.textContent=flavor.name;
    subtitleEl.textContent=flavor.subtitle;
    descEl.textContent=flavor.desc;
    renderMeta([...flavor.meta,...Object.keys(flavor.sizes)]);
    renderSizes(flavor);
    updateProgressDots();
    await renderBottle(flavor,!animateBottle);
  }

  async function goToFlavor(index, animate){
    if(index<0||index>=flavors.length) return;
    if(isAnimBottle) return;
    await renderFlavor(index,animate);
  }

  /* ─ INIT ─ */
  activeSize=Object.keys(flavors[0].sizes)[0];
  preferredSize=activeSize;
  preloadAll();
  buildProgressDots();
  renderFlavor(0,false);
  window.addEventListener('resize',()=>{
    if(activeSize){
      const currentFlavor = flavors[activeFlavor];
      bottle.style.width=bottleWidthFor(currentFlavor,activeSize);
      bottle.style.transform='none';
    }
  });

  /* ═══════════════════════════════════════════════════════════
     SCROLL GATE — Elementor-safe, smooth, centered
     Strategy:
     • Trigger EARLY: when stage top enters bottom 30% of viewport
     • Immediately snap stage to center with scrollIntoView (browser-native, buttery)
     • While gate is active: cancel all scroll events AND enforce
       position via a scroll listener that snaps back if drift occurs
     • Each downward scroll = one flavor step
     • Scroll up = instant gate release, no position restore needed
  ═══════════════════════════════════════════════════════════ */

  const stageEl = document.getElementById('nat100-nfFlavorStage');
  function getSnapEl(){ return stageEl || tastesSection; }

  /* Find the real scroll container — works in Elementor wrappers */
  function findScrollContainer(){
    let el = tastesSection.parentElement;
    while(el && el !== document.documentElement){
      const s = window.getComputedStyle(el);
      if(/(auto|scroll|overlay)/.test(s.overflowY) && el.scrollHeight > el.clientHeight + 2) return el;
      el = el.parentElement;
    }
    return window;
  }

  function getRawScroll(c){ return c === window ? (window.pageYOffset || document.documentElement.scrollTop || 0) : c.scrollTop; }
  function setRawScroll(c, top){ if(c === window) window.scrollTo({top, behavior:'instant'}); else c.scrollTop = top; }
  function smoothScrollTo(c, top){ if(c === window) window.scrollTo({top, behavior:'smooth'}); else c.scrollTo({top, behavior:'smooth'}); }

  let scrollContainer = findScrollContainer();

  function navH(){ const tb = root.querySelector('.topbar'); return tb ? tb.offsetHeight : 0; }

  /* Compute the scroll position that perfectly centers the stage */
  function computeSnapY(){
    const el    = getSnapEl();
    const rect  = el.getBoundingClientRect();
    const nav   = navH();
    const usable = window.innerHeight - nav;
    const pad   = Math.max(0, (usable - rect.height) / 2);
    return Math.max(0, getRawScroll(scrollContainer) + rect.top - nav - pad);
  }

  /* ── State ── */
  let gateActive  = false;
  let stepLocked  = false;
  let lockedAt    = 0;      // the scroll position we're holding at
  let enforcing   = false;  // scroll-listener enforcement active
  let touchStartY = 0;
  let hintTimer   = null;

  function showHint(last){
    clearTimeout(hintTimer);
    hintTextEl.textContent = last ? 'Scroll to continue' : 'Scroll to explore';
    hintEl.classList.add('visible');
    hintTimer = setTimeout(()=>hintEl.classList.remove('visible'), 2800);
  }
  function hideHint(){ clearTimeout(hintTimer); hintEl.classList.remove('visible'); }

  /* Enforce scroll position — called by scroll listener while gate is active */
  function onScrollEnforce(){
    if(!enforcing) return;
    const current = getRawScroll(scrollContainer);
    if(Math.abs(current - lockedAt) > 2){
      setRawScroll(scrollContainer, lockedAt);
    }
  }

  /* Lock: snap to center, then hold position via scroll listener */
  function enterGate(){
    if(gateActive) return;
    gateActive = true;
    lockedAt   = computeSnapY();

    /* Smooth scroll to locked position */
    smoothScrollTo(scrollContainer, lockedAt);

    /* After scroll settles, start enforcing */
    setTimeout(()=>{
      /* Re-compute in case layout shifted during scroll */
      lockedAt  = computeSnapY();
      setRawScroll(scrollContainer, lockedAt);
      enforcing = true;
    }, 380);

    showHint(false);
  }

  /* Unlock downward — move past the section cleanly */
  function exitGateDown(){
    if(!gateActive) return;
    enforcing  = false;
    gateActive = false;
    stepLocked = false;
    const past = lockedAt + getSnapEl().offsetHeight + 60;
    smoothScrollTo(scrollContainer, past);
    hideHint();
  }

  /* Unlock upward — just release, user scrolls freely */
  function exitGateUp(){
    if(!gateActive) return;
    enforcing  = false;
    gateActive = false;
    stepLocked = false;
    hideHint();
  }

  /* Step one flavor forward */
  function stepForward(){
    if(stepLocked || isAnimBottle) return;
    if(activeFlavor >= flavors.length - 1){ exitGateDown(); return; }
    stepLocked = true;
    const next = activeFlavor + 1;
    preferredSize = getPreferredSize(flavors[next]);
    goToFlavor(next, true);
    showHint(next === flavors.length - 1);
    setTimeout(()=>{ stepLocked = false; }, 580);
  }

  /* Trigger: when stage top reaches 80% down the viewport (early, before center) */
  function shouldEnterGate(){
    if(gateActive) return false;
    if(activeFlavor >= flavors.length - 1) return false;
    const rect = getSnapEl().getBoundingClientRect();
    const nav  = navH();
    const vh   = window.innerHeight;
    /* Fire when stage top is within the lower 35% of usable viewport */
    return rect.top <= nav + (vh - nav) * 0.82 && rect.bottom > nav + 80;
  }

  /* ── Scroll enforcement listener ── */
  const scrollTarget = scrollContainer === window ? window : scrollContainer;
  scrollTarget.addEventListener('scroll', onScrollEnforce, { passive: true });

  /* ── WHEEL ── */
  window.addEventListener('wheel', e => {
    if(e.deltaY < 0){
      if(gateActive){ e.preventDefault(); exitGateUp(); }
      return;
    }
    if(!gateActive && shouldEnterGate()){ e.preventDefault(); enterGate(); return; }
    if(gateActive){ e.preventDefault(); stepForward(); }
  }, { passive: false });

  /* ── TOUCH ── */
  window.addEventListener('touchstart', e => {
    if(e.touches[0]) touchStartY = e.touches[0].clientY;
  }, { passive: true });

  window.addEventListener('touchmove', e => {
    if(!e.touches[0]) return;
    const dy = touchStartY - e.touches[0].clientY;
    if(dy < 0){ if(gateActive){ e.preventDefault(); exitGateUp(); } return; }
    if(Math.abs(dy) < 18) return;
    if(!gateActive && shouldEnterGate()){ e.preventDefault(); enterGate(); touchStartY = e.touches[0].clientY; return; }
    if(gateActive){ e.preventDefault(); touchStartY = e.touches[0].clientY; stepForward(); }
  }, { passive: false });

  /* ── KEYBOARD ── */
  window.addEventListener('keydown', e => {
    if(!gateActive) return;
    if(e.key === 'ArrowDown' || e.key === ' '){ e.preventDefault(); stepForward(); }
    if(e.key === 'ArrowUp'){ e.preventDefault(); exitGateUp(); }
  });

  /* ── Resize: recompute snap position if gate is active ── */
  window.addEventListener('resize', () => {
    scrollContainer = findScrollContainer();
    if(gateActive){ lockedAt = computeSnapY(); setRawScroll(scrollContainer, lockedAt); }
  }, { passive: true });

  /* ── Nav links release gate ── */
  root.querySelectorAll('a[href^="#"]').forEach(a=>{
    a.addEventListener('click',()=>{ if(gateActive) exitGateUp(); });
  });

})();
</script>

