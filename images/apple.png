<style>
  .frutex-footer-v1,
  .frutex-footer-v1 * {
    box-sizing: border-box;
    font-family: "SF Pro Display", "SF Pro Text", Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif !important;
  }

  .frutex-footer-v1 {
    --frx-green-dark: #0f5d43;
    --frx-green: #167a59;
    --frx-green-light: #1b8b66;
    --frx-text: #1a3f31;
    --frx-text-soft: rgba(26, 63, 49, 0.78);
    --frx-border: rgba(22, 122, 89, 0.14);
    --frx-bg-top: rgba(255, 255, 255, 0.96);
    --frx-bg-bottom: rgba(255, 255, 255, 0.82);
    --frx-card-top: rgba(255, 255, 255, 0.92);
    --frx-card-bottom: rgba(246, 251, 248, 0.88);
    --frx-shadow: 0 16px 40px rgba(15, 93, 67, 0.08), 0 28px 70px rgba(15, 93, 67, 0.08);

    position: relative;
    width: min(1480px, calc(100% - 20px));
    margin: 36px auto 18px;
    color: var(--frx-text);
  }

  .frutex-footer-v1__shell {
    border: 1px solid var(--frx-border);
    border-radius: 34px;
    overflow: hidden;
    background: linear-gradient(180deg, var(--frx-bg-top), var(--frx-bg-bottom));
    backdrop-filter: blur(18px) saturate(160%);
    -webkit-backdrop-filter: blur(18px) saturate(160%);
    box-shadow: var(--frx-shadow);
  }

  .frutex-footer-v1__top {
    display: grid;
    grid-template-columns: minmax(280px, 1.1fr) minmax(0, 1.4fr);
    gap: 22px;
    padding: 28px;
  }

  .frutex-footer-v1__brand,
  .frutex-footer-v1__col {
    border: 1px solid rgba(22, 122, 89, 0.1);
    background: linear-gradient(180deg, var(--frx-card-top), var(--frx-card-bottom));
    border-radius: 28px;
    backdrop-filter: blur(16px) saturate(150%);
    -webkit-backdrop-filter: blur(16px) saturate(150%);
    box-shadow: 0 12px 30px rgba(15, 93, 67, 0.06);
  }

  .frutex-footer-v1__brand {
    padding: 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 18px;
    min-width: 0;
  }

  .frutex-footer-v1__logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    width: fit-content;
  }

  .frutex-footer-v1__logo img {
    display: block;
    height: 42px;
    width: auto;
    max-width: min(100%, 220px);
    object-fit: contain;
  }

  .frutex-footer-v1__text {
    margin: 0;
    color: var(--frx-text-soft);
    font-size: 15px;
    line-height: 1.7;
    max-width: 560px;
  }

  .frutex-footer-v1__cta {
    display: flex;
    align-items: center;
  }

  .frutex-footer-v1__catalogue-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 20px;
    border-radius: 999px;
    text-decoration: none;
    color: #ffffff !important;
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0.01em;
    background: linear-gradient(135deg, var(--frx-green-dark), var(--frx-green-light));
    border: 1px solid rgba(15, 93, 67, 0.16);
    box-shadow: 0 12px 24px rgba(15, 93, 67, 0.18);
    transition: transform .22s ease, box-shadow .22s ease, filter .22s ease;
  }

  .frutex-footer-v1__catalogue-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 16px 30px rgba(15, 93, 67, 0.24);
    filter: brightness(1.03);
    color: #ffffff !important;
  }

  .frutex-footer-v1__contact {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .frutex-footer-v1__contact a,
  .frutex-footer-v1__col a,
  .frutex-footer-v1__powered a {
    text-decoration: none;
    color: var(--frx-text);
    transition: color .22s ease, background .22s ease, transform .22s ease;
  }

  .frutex-footer-v1__contact a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 14px;
    border-radius: 999px;
    background: rgba(22, 122, 89, 0.07);
    border: 1px solid rgba(22, 122, 89, 0.08);
    font-size: 13px;
    font-weight: 700;
  }

  .frutex-footer-v1__contact a:hover,
  .frutex-footer-v1__col a:hover,
  .frutex-footer-v1__powered a:hover {
    color: var(--frx-green-dark);
  }

  .frutex-footer-v1__contact a:hover {
    transform: translateY(-1px);
    background: rgba(22, 122, 89, 0.1);
  }

  .frutex-footer-v1__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
    min-width: 0;
  }

  .frutex-footer-v1__col {
    padding: 22px 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }

  .frutex-footer-v1__col h3 {
    margin: 0 0 8px;
    color: var(--frx-green-dark);
    font-size: 16px;
    font-weight: 800;
    line-height: 1.2;
  }

  .frutex-footer-v1__col a {
    display: flex;
    align-items: center;
    min-height: 42px;
    padding: 0 12px;
    border-radius: 14px;
    font-size: 14px;
    font-weight: 600;
    background: transparent;
    word-break: break-word;
  }

  .frutex-footer-v1__col a:hover {
    background: rgba(22, 122, 89, 0.08);
  }

  .frutex-footer-v1__bottom {
    display: flex !important;
    flex-direction: row !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 24px;
    padding: 18px 28px 22px !important;
    border-top: 1px solid rgba(22, 122, 89, 0.1);
    color: var(--frx-text-soft);
    font-size: 13px;
    font-weight: 700;
  }

  .frutex-footer-v1__copyright {
    min-height: 24px !important;
    display: flex;
    align-items: center;
    text-align: center !important;
  }

  .frutex-footer-v1__powered {
    min-height: 24px !important;
    display: flex;
    align-items: center;
    justify-content: center !important;
    flex-wrap: wrap;
    gap: 6px;
    text-transform: none !important;
  }

  .frutex-footer-v1__powered a {
    color: #007aff !important;
    font-weight: 900 !important;
  }

  .frutex-footer-v1__powered a:hover {
    color: #005ecb !important;
  }

  @media (max-width: 1180px) {
    .frutex-footer-v1__top {
      grid-template-columns: 1fr;
    }

    .frutex-footer-v1__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .frutex-footer-v1 {
      width: calc(100% - 14px);
      margin: 22px auto 12px;
    }

    .frutex-footer-v1__shell {
      border-radius: 24px;
    }

    .frutex-footer-v1__top {
      gap: 14px;
      padding: 14px;
    }

    .frutex-footer-v1__brand,
    .frutex-footer-v1__col {
      border-radius: 20px;
    }

    .frutex-footer-v1__brand {
      padding: 18px;
    }

    .frutex-footer-v1__grid {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .frutex-footer-v1__col {
      padding: 18px 16px;
    }

    .frutex-footer-v1__logo img {
      height: 34px;
      max-width: 180px;
    }

    .frutex-footer-v1__text {
      font-size: 14px;
    }

    .frutex-footer-v1__catalogue-btn {
      width: 100%;
      min-height: 46px;
      padding: 0 16px;
    }

    .frutex-footer-v1__bottom {
      flex-direction: column !important;
      gap: 8px !important;
      padding: 16px 18px 18px !important;
      text-align: center !important;
    }
  }
</style>			<script>
				const lazyloadRunObserver = () => {
					const lazyloadBackgrounds = document.querySelectorAll( `.e-con.e-parent:not(.e-lazyloaded)` );
					const lazyloadBackgroundObserver = new IntersectionObserver( ( entries ) => {
						entries.forEach( ( entry ) => {
							if ( entry.isIntersecting ) {
								let lazyloadBackground = entry.target;
								if( lazyloadBackground ) {
									lazyloadBackground.classList.add( 'e-lazyloaded' );
								}
								lazyloadBackgroundObserver.unobserve( entry.target );
							}
						});
					}, { rootMargin: '200px 0px 200px 0px' } );
					lazyloadBackgrounds.forEach( ( lazyloadBackground ) => {
						lazyloadBackgroundObserver.observe( lazyloadBackground );
					} );
				};
				const events = [
					'DOMContentLoaded',
					'elementor/lazyload/observe',
				];
				events.forEach( ( event ) => {
					document.addEventListener( event, lazyloadRunObserver );
				} );
			</script>
