<!-- Progress dots -->
<div class="nf-progress" id="nat100-nfProgress"><div class="nf-progress-dot" data-i="0"></div><div class="nf-progress-dot" data-i="1"></div><div class="nf-progress-dot active" data-i="2"></div><div class="nf-progress-dot" data-i="3"></div><div class="nf-progress-dot" data-i="4"></div><div class="nf-progress-dot" data-i="5"></div><div class="nf-progress-dot" data-i="6"></div><div class="nf-progress-dot" data-i="7"></div><div class="nf-progress-dot" data-i="8"></div><div class="nf-progress-dot" data-i="9"></div><div class="nf-progress-dot" data-i="10"></div></div>

