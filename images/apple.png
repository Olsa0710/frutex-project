    <style>
      .brand-protected{
        display:inline !important;
        white-space:normal !important;
        word-spacing:normal !important;
        letter-spacing:normal !important;
      }
    </style>

    <script>
    (function () {
      const protectedTerms = [
        "Golden Eagle Foundation",
        "Natural 100%",
        "Golden Eagle",
        "Art Food",
        "Freesia",
        "Relax",
        "ZEROS"
      ];

      const skipTags = new Set([
        "SCRIPT",
        "STYLE",
        "NOSCRIPT",
        "IFRAME",
        "TEXTAREA",
        "INPUT",
        "OPTION",
        "CODE",
        "PRE"
      ]);

      function escapeRegExp(string) {
        return string.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
      }

      const sortedTerms = protectedTerms.slice().sort((a, b) => b.length - a.length);
      const pattern = new RegExp("(" + sortedTerms.map(escapeRegExp).join("|") + ")", "g");

      function isLetterOrNumber(char) {
        return !!char && /[0-9A-Za-zÀ-ÖØ-öø-ÿĀ-ž]/.test(char);
      }

      function getLastChar(str) {
        return str ? str.slice(-1) : "";
      }

      function getFirstChar(str) {
        return str ? str.charAt(0) : "";
      }

      function shouldSkipNode(node) {
        if (!node || !node.parentNode) return true;
        const parent = node.parentNode;
        if (!parent.tagName) return true;
        if (skipTags.has(parent.tagName)) return true;
        if (parent.closest(".notranslate, [translate='no'], .skiptranslate, #goog-gt-tt")) return true;
        return false;
      }

      function wrapProtectedTermsInTextNode(textNode) {
        if (shouldSkipNode(textNode)) return;

        const text = textNode.nodeValue;
        if (!text) return;

        pattern.lastIndex = 0;
        if (!pattern.test(text)) {
          pattern.lastIndex = 0;
          return;
        }
        pattern.lastIndex = 0;

        const fragment = document.createDocumentFragment();
        let lastIndex = 0;
        let match;

        while ((match = pattern.exec(text)) !== null) {
          const before = text.slice(lastIndex, match.index);
          if (before) fragment.appendChild(document.createTextNode(before));

          const span = document.createElement("span");
          span.className = "notranslate brand-protected";
          span.setAttribute("translate", "no");
          span.textContent = match[0];
          fragment.appendChild(span);

          lastIndex = match.index + match[0].length;
        }

        const after = text.slice(lastIndex);
        if (after) fragment.appendChild(document.createTextNode(after));

        if (textNode.parentNode) {
          textNode.parentNode.replaceChild(fragment, textNode);
        }
      }

      function processElement(root) {
        if (!root) return;

        if (root.nodeType === Node.TEXT_NODE) {
          wrapProtectedTermsInTextNode(root);
          return;
        }

        if (root.nodeType !== Node.ELEMENT_NODE) return;
        if (skipTags.has(root.tagName)) return;
        if (root.matches(".notranslate, [translate='no'], .skiptranslate, .brand-protected")) return;

        const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, null, false);
        const textNodes = [];

        while (walker.nextNode()) {
          textNodes.push(walker.currentNode);
        }

        textNodes.forEach(wrapProtectedTermsInTextNode);
      }

      function ensureSpaceBefore(el) {
        const prev = el.previousSibling;

        if (!prev) return;

        if (prev.nodeType === Node.TEXT_NODE) {
          const value = prev.nodeValue || "";
          if (!value) {
            prev.nodeValue = " ";
            return;
          }

          const lastChar = getLastChar(value);
          if (isLetterOrNumber(lastChar) && !/\s$/.test(value)) {
            prev.nodeValue = value + " ";
          }
          return;
        }

        if (prev.nodeType === Node.ELEMENT_NODE) {
          const text = prev.textContent || "";
          const lastChar = getLastChar(text.trimEnd());
          if (isLetterOrNumber(lastChar)) {
            el.parentNode.insertBefore(document.createTextNode(" "), el);
          }
        }
      }

      function ensureSpaceAfter(el) {
        const next = el.nextSibling;

        if (!next) return;

        if (next.nodeType === Node.TEXT_NODE) {
          const value = next.nodeValue || "";
          if (!value) {
            next.nodeValue = " ";
            return;
          }

          const firstChar = getFirstChar(value);
          if (isLetterOrNumber(firstChar) && !/^\s/.test(value)) {
            next.nodeValue = " " + value;
          }
          return;
        }

        if (next.nodeType === Node.ELEMENT_NODE) {
          const text = next.textContent || "";
          const firstChar = getFirstChar(text.trimStart());
          if (isLetterOrNumber(firstChar)) {
            el.parentNode.insertBefore(document.createTextNode(" "), next);
          }
        }
      }

      function normalizeBrandSpacing(root) {
        const scope = root && root.nodeType === 1 ? root : document;
        const brands = scope.querySelectorAll ? scope.querySelectorAll(".brand-protected") : [];

        brands.forEach(function (el) {
          if (!el.parentNode) return;
          ensureSpaceBefore(el);
          ensureSpaceAfter(el);
        });
      }

      function initProtection() {
        if (!document.body) return;
        processElement(document.body);
        normalizeBrandSpacing(document.body);
      }

      function runAll(node) {
        if (!node) return;
        processElement(node.nodeType === 1 || node.nodeType === 11 ? node : node.parentNode);
        normalizeBrandSpacing(document.body);
      }

      document.addEventListener("DOMContentLoaded", function () {
        initProtection();

        const observer = new MutationObserver(function (mutations) {
          mutations.forEach(function (mutation) {
            mutation.addedNodes.forEach(function (node) {
              runAll(node);
            });

            if (mutation.type === "characterData") {
              runAll(mutation.target);
            }
          });
        });

        if (document.body) {
          observer.observe(document.body, {
            childList: true,
            subtree: true,
            characterData: true
          });
        }

        setTimeout(function(){ normalizeBrandSpacing(document.body); }, 500);
        setTimeout(function(){ normalizeBrandSpacing(document.body); }, 1500);
        setTimeout(function(){ normalizeBrandSpacing(document.body); }, 3000);
      });
    })();
    </script>
    



